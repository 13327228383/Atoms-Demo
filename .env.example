# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 默认：本机 Ollama，零成本、无需注册
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 切换到任意 OpenAI 兼容接口（提速 / 提质）：
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PORT=8787
HOST=0.0.0.0
